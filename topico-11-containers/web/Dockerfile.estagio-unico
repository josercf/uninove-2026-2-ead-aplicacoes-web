# Versão de estágio único, só para medir o tamanho: Node, node_modules e código-fonte ficam na imagem final.
FROM node:22-alpine
WORKDIR /origem
COPY . .
RUN npm ci && npm run build
EXPOSE 4173
# vite preview serve a pasta dist; --host libera o acesso de fora do container.
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "4173"]
